{
  "name": "pafish-starter",
  "title": "Pafish Theme Starter",
  "version": "1.0.0",
  "apiVersion": 2,
  "description": "可独立开发的 PHP 主题起点：页面结构、样式和模板数据都由主题掌控。",
  "author": "Pafish",
  "injects": ["head", "footer", "sidebar", "comment_form", "login_form", "register_form"],
  "systemTemplateFallback": [],
  "userData": ["posts", "stats", "reactions", "comments", "points"],
  "settings": [
    {
      "key": "show_post_cover",
      "label": "文章页显示封面",
      "type": "switcher",
      "group": "文章",
      "default": "1"
    },
    {
      "key": "show_related_posts",
      "label": "显示相关文章",
      "type": "switcher",
      "group": "文章",
      "default": "1"
    },
    {
      "key": "footer_text",
      "label": "页脚文字",
      "type": "text",
      "group": "站点",
      "default": "",
      "maxlength": 120,
      "placeholder": "留空时显示年份和站点名称"
    }
  ]
}
