# pafish (PHP) 忽略规则
/vendor/
/config.php
/runtime/*
!/runtime/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep
/backups/*
!/backups/.gitkeep

# 编辑器/系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 日志
*.log

# 构建产物（发布包，随 GitHub Release 分发）
/dist/

# 文档由独立文档站维护，不进入主程序仓库
/docs/

# 本地开发资产：不随源码仓库发布
/deploy_*.sh
/test_*.php
/public/*visual-check*.html
/docs/*implementation*.md
/scripts/port-lumina*.php
/themes/lumina/
/themes/lumina.zip
/plugins/notify-hub/
/plugins/notify-hub.zip
/plugins/seo-push/
/plugins/seo-push.zip
