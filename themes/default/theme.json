{
  "name": "default",
  "title": "默认主题",
  "version": "1.2.3",
  "apiVersion": 2,
  "injects": [],
  "systemTemplateFallback": ["index", "post", "page", "category", "tag", "search", "archives", "micro", "user"],
  "description": "pafish 默认主题。",
  "author": "纸鱼官方",
  "authorUrl": "https://pafish.cn/developers/pafish",
  "homepage": "https://www.pafish.cn",
  "settings": [
    {
      "key": "footer_text",
      "label": "页脚文案",
      "type": "text",
      "group": "内容",
      "default": "",
      "placeholder": "留空使用默认（© 年份 站点名 · 用 PHP 构建）"
    },
    {
      "key": "show_custom_fields",
      "label": "文章页显示自定义字段",
      "type": "checkbox",
      "group": "内容",
      "default": "1"
    },
    {
      "key": "sidebar_enabled",
      "label": "显示桌面侧边栏",
      "type": "checkbox",
      "group": "布局",
      "default": "1"
    },
    {
      "key": "show_post_cover",
      "label": "文章详情页显示封面",
      "type": "checkbox",
      "group": "布局",
      "default": "0"
    },
    {
      "key": "show_related_posts",
      "label": "文章页显示相关推荐",
      "type": "checkbox",
      "group": "布局",
      "default": "1"
    }
  ]
}
