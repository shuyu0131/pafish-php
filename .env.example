# Copy this file to .env and replace both passwords with different 32+ character
# hexadecimal random values (for example, generate each with `openssl rand -hex 32`).
MYSQL_DATABASE=pafish
MYSQL_USER=pafish
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Published image used by the release Compose file. Pin a version in production.
PAFISH_IMAGE=ghcr.io/shuyu0131/pafish-php:latest

# The default binding exposes the site only on this host. A host-level reverse
# proxy can reach it at http://127.0.0.1:8080.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
