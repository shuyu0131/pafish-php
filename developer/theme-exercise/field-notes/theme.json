{
  "name": "field-notes",
  "title": "Field Notes",
  "version": "1.0.0",
  "apiVersion": 2,
  "description": "A compact editorial theme built from an empty directory as a development exercise.",
  "author": "Pafish",
  "injects": ["footer"],
  "systemTemplateFallback": ["category", "tag", "search", "archives", "micro"],
  "pageTemplates": [
    { "name": "reading", "title": "专注阅读", "description": "适合长文阅读的宽版页面布局。" }
  ],
  "settings": [
    {
      "key": "home_kicker",
      "label": "首页眉题",
      "type": "text",
      "group": "首页",
      "default": "FIELD NOTES / 最新记录",
      "maxlength": 48
    },
    {
      "key": "home_intro",
      "label": "首页介绍",
      "type": "textarea",
      "group": "首页",
      "default": "把值得记下来的想法，留给下一次阅读。",
      "maxlength": 180
    },
    {
      "key": "show_post_cover",
      "label": "文章页显示封面",
      "type": "switcher",
      "group": "阅读",
      "default": "1"
    },
    {
      "key": "show_related_posts",
      "label": "文章页显示延伸阅读",
      "type": "switcher",
      "group": "阅读",
      "default": "1"
    },
    {
      "key": "footer_note",
      "label": "页脚说明",
      "type": "text",
      "group": "站点",
      "default": "慢一点写，也慢一点读。",
      "maxlength": 100
    },
    {
      "key": "studio_label",
      "label": "主题扩展标记",
      "type": "text",
      "group": "站点",
      "default": "由 Field Notes 主题扩展提供",
      "maxlength": 80
    }
  ]
}
